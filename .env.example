# se-pipeline configuration
#
# Edit this file directly, OR use the CLI once services are running:
#   se-pipeline config set GROQ_API_KEY gsk_...
#   se-pipeline config set DEEPSEEK_API_KEY sk-...
#
# Changes take effect on the next pipeline run — no container restart needed.

# ── Required ──────────────────────────────────────────────────────────────────
# Groq API key — used by the requirements and standards agents
# Get one free at: https://console.groq.com
GROQ_API_KEY=

# ── Optional (but recommended) ────────────────────────────────────────────────
# DeepSeek API key — used by the coder agent for higher quality code generation
# Without this key the coder agent falls back to Groq (lower code quality)
# Get one at: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────
# Slack webhook URL for pipeline completion notifications
SLACK_WEBHOOK_URL=

# ── Advanced (defaults work for most users) ───────────────────────────────────
LLM_PRIMARY_PROVIDER=deepseek
LLM_FALLBACK_PROVIDER=groq
SECRET_KEY=change-me-in-production
